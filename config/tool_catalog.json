        "parameters": {
          "type": "object",
          "properties": {
            "color": {"type": "string"}
          }
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "camera_snapshot",
        "description": "Snapshot-Info des aktuellen Frames in /dev/shm — Pfad/Groesse/Alter.",
        "parameters": {"type": "object", "properties": {}}
      }
    }
  ]
}
