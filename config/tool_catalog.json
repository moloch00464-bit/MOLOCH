{
  "version": "1.0",
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "web_search",
        "description": "Suche im Web via DuckDuckGo. Returnt Liste von Treffern mit Title, URL, Snippet.",
        "parameters": {
          "type": "object",
          "properties": {
            "query": {"type": "string", "description": "Suchanfrage"},
            "max_results": {"type": "integer", "default": 5}
          },
          "required": ["query"]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "web_fetch",
        "description": "Hole HTML-Seite und extrahiere Text. Returnt {title, text, chars}.",
        "parameters": {
          "type": "object",
          "properties": {
            "url": {"type": "string"},
            "max_chars": {"type": "integer", "default": 8000}
          },
          "required": ["url"]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "spotify_top_artists",
        "description": "Markus' Top-Artists aus Spotify-Profil. Returnt Liste mit name + play_count.",
        "parameters": {
          "type": "object",
          "properties": {
            "n": {"type": "integer", "default": 20}
          }
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "spotify_play",
        "description": "Spielt einen Track/Artist/Playlist. Akzeptiert Spotify-URI ODER Suchstring.",
        "parameters": {
          "type": "object",
          "properties": {
            "query_or_uri": {"type": "string"}
          },
          "required": ["query_or_uri"]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "spotify_top_tracks",
        "description": "Markus' Top-Tracks aus Spotify-Profil. Returnt Liste mit name/artist/play_count.",
        "parameters": {
          "type": "object",
          "properties": {
            "n": {"type": "integer", "default": 20}
          }
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "spotify_pause",
        "description": "Pausiert die aktuelle Wiedergabe.",
        "parameters": {"type": "object", "properties": {}}
      }
    },
    {
      "type": "function",
      "function": {
        "name": "spotify_next",
        "description": "Skip zum naechsten Track.",
        "parameters": {"type": "object", "properties": {}}
      }
    },
    {
      "type": "function",
      "function": {
        "name": "spotify_prev",
        "description": "Vorheriger Track.",
        "parameters": {"type": "object", "properties": {}}
      }
    },
    {
      "type": "function",
      "function": {
        "name": "spotify_volume",
        "description": "Setzt Lautstaerke 0-100 (Prozent).",
        "parameters": {
          "type": "object",
          "properties": {
            "percent": {"type": "integer"}
          },
          "required": ["percent"]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "spotify_search",
        "description": "Suche nach Track/Artist/Album im lokalen Index (KEIN Spotify-API).",
        "parameters": {
          "type": "object",
          "properties": {
            "query": {"type": "string"}
          },
          "required": ["query"]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "spotify_now_playing",
        "description": "Aktueller Track + playing-Status aus state-file.",
        "parameters": {"type": "object", "properties": {}}
      }
    },
    {
      "type": "function",
      "function": {
        "name": "spotify_recommend",
        "description": "Empfehlung aus lokalem Index — best-effort zonen-basiert. KEIN Spotify-API.",
        "parameters": {
          "type": "object",
          "properties": {
            "seed_genre": {"type": "string"},
            "target_energy": {"type": "number"}
          }
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "spotify_play_genre",
