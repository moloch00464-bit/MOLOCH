config/camera_cloud.json
config/sonoff_camera.json
config/certs/
moloch_context.json
moloch_context.json.bak
context/personal_context.json
SYSTEM_STATE.json
.env
*.secret

# --- Models & Large Files ---
models/

# --- Runtime Data ---
faces/
snapshots/
data/
logs/
*.log
config/last_face_position.json
config/learned_patrol_positions.json

# --- Images & Media ---
*.jpg
*.jpeg
*.png
*.gif
*.mp4
*.wav
*.mp3

# --- Python ---
__pycache__/
*.py[cod]
*.class
*.so
*.egg-info/
dist/
build/
*.egg
.eggs/
venv/
.venv/
env/

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db
*.bak
*.bak.*
state/timeline.jsonl
.env.spotify

# --- PlatformIO Build Cache ---
firmware/**/.pio/

# --- Federation Auto-Reply Run-State (cross_session_monitor) ---
