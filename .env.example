# M.O.L.O.C.H. Environment Variables
# Kopiere diese Datei nach .env und setze die echten Werte ein.
# .env ist in .gitignore und wird NICHT committed.

# Kamera-Credentials (Sonoff CAM-PT2)
MOLOCH_CAMERA_USER=DEIN_USER
MOLOCH_CAMERA_PASS=DEIN_PASSWORT
MOLOCH_RTSP_URL=rtsp://USER:PASS@192.168.178.25:554/av_stream/ch0

# eWeLink Cloud (Kamera LED, IR, Alarm)
EWELINK_PASSWORD=DEIN_EWELINK_PASSWORT
EWELINK_APP_SECRET_1=DEIN_APP_SECRET
